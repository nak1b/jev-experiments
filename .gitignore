# Shared by every experiment. Framework-specific ignores live in each experiment's own .gitignore.

# dependencies
node_modules/

# env files hold secrets. Only the template is committed.
.env*
!.env.example

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
